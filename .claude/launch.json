{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kunsu-ui-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "ui",
        "dev",
        "--port",
        "1420"
      ],
      "port": 1420
    },
    {
      "name": "kunsu-prototypes",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "ui",
        "exec",
        "vite",
        "../docs/prototypes",
        "--port",
        "1550",
        "--strictPort"
      ],
      "port": 1550
    },
    {
      "name": "kunsu-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}